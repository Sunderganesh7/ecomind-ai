# .env.example - EcoMind AI Environment Variables

# Application
APP_ENV=development
APP_NAME=EcoMindAI
APP_PORT=8000

# Security
SECRET_KEY=
MAX_REQUEST_SIZE=2097152
RATE_LIMIT_PER_MINUTE=100

# Database
DATABASE_URL=

# AI / LLM
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

# Embeddings / RAG
EMBEDDING_MODEL=

# External environmental data
ENVIRONMENTAL_API_KEY=

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Frontend
FRONTEND_URL=http://localhost:5173
